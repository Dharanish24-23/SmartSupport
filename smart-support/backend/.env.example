# ------------------------------------------------------------------
# Copy this file to `.env` (or set these as real environment
# variables / OS environment variables) and NEVER commit real
# secrets to version control.
# ------------------------------------------------------------------


# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/smart_support_db
DB_USERNAME=postgres
DB_PASSWORD=root@123

# Server
SERVER_PORT=8080

# JWT
JWT_SECRET=ChangeThisSuperSecretKeyForSmartSupportDemoProjectOnly123456
JWT_EXPIRATION_MS=86400000

# File uploads
UPLOAD_DIR=uploads

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Default admin account seeded on first startup
ADMIN_EMAIL=admin@smartsupport.com
ADMIN_PASSWORD=Admin@1234
